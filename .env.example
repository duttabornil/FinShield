# FinShield Environment Configuration (Prototype)

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Port
FRONTEND_PORT=5173

# PostgreSQL connection string used by scripts/import_data.py.
# Example: postgresql+psycopg://finshield:<your-password>@localhost:5432/finshield
# DATABASE_URL=

# Optional: LLM API Keys (FinShield works 100% offline out-of-the-box using deterministic templates)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Environment Label
ENVIRONMENT=SYNTHETIC_HACKATHON_PROTOTYPE
DEMO_MODE=true
